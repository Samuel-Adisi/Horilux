# Horilux backend environment. Copy to Horilux/.env (loaded from BASE_DIR,
# i.e. this directory) and fill in real values. Only variables that the
# settings actually read are listed here.

# Settings module: Horilux.settings.dev (default for manage.py),
# Horilux.settings.staging or Horilux.settings.production.
DJANGO_SETTINGS_MODULE=Horilux.settings.dev

# Required in staging/production. base.py falls back to an insecure key.
SECRET_KEY=change-me

# Required. Postgres URL; base.py connects with ssl_require=True.
DATABASE_URL=postgres://user:password@host:5432/horilux

# Cloudinary media storage (needed for any upload or file URL).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- staging / production only -------------------------------------------
# "True" to enable debug in production.py (staging is always DEBUG=False).
DEBUG=False
# Comma-separated host names.
ALLOWED_HOSTS=api.example.com
# Comma-separated frontend origins (e.g. the Vercel URL).
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
# production.py only; defaults to True.
SECURE_SSL_REDIRECT=True

# Set by the platform; used by the Procfile's gunicorn bind.
PORT=8000
