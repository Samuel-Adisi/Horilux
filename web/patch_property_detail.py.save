#!/usr/bin/env python3
import pathlib

path = pathlib.Path(
    
"/Users/hajiafati/Desktop/Horilux/Horilux/web/src/features/properties/components/PropertyDetailPage.tsx"
)

text = path.read_text()

OLD_IMPORT_ANCHOR = 'import { useUploadPropertyMedia, 
useDeletePropertyMedia } from "../hooks/use-property-media";'

SKELETON_FN = '''

function PropertyDetailSkeleton() {
  return (
    <div className="overflow-hidden rounded-[8px] border border-[#E4E1D9] 
bg-white">
      <div className="h-[460px] w-full animate-pulse bg-[#EFEDE6]" />

      <div className="border-b border-[#EFEDE6] px-5 py-4">
        <div className="h-5 w-1/2 animate-pulse rounded bg-[#EFEDE6]" />
        <div className="mt-2 h-3.5 w-1/3 animate-pulse rounded 
bg-[#EFEDE6]" />
        <div className="mt-3 h-5 w-24 animate-pulse rounded bg-[#EFEDE6]" 
/>
      </div>

      <div className="grid grid-cols-2 gap-4 border-b border-[#EFEDE6] 
px-5 py-4 sm:grid-cols-4">
        {Array.from({ length: 8 }).map((_, i) => (
          <div key={i}>
            <div className="h-3 w-16 animate-pulse rounded bg-[#EFEDE6]" 
/>
            <div className="mt-1.5 h-3.5 w-12 animate-pulse rounded 
bg-[#EFEDE6]" />
          </div>
        ))}
      </div>

      <div className="border-b border-[#EFEDE6] px-5 py-4">
        <div className="h-3 w-16 animate-pulse rounded bg-[#EFEDE6]" />
        <div className="mt-2.5 grid grid-cols-3 gap-2.5 sm:grid-cols-4">
          {Array.from({ length: 4 }).map((_, i) => (
            <div key={i} className="aspect-square animate-pulse 
rounded-[6px] bg-[#EFEDE6]" />
          ))}
        </div>
      </div>

      <div className="px-5 py-4">
        <div className="h-3 w-20 animate-pulse rounded bg-[#EFEDE6]" />
        <div className="mt-2 h-3.5 w-full animate-pulse rounded 
bg-[#EFEDE6]" />
        <div className="mt-1.5 h-3.5 w-2/3 animate-pulse rounded 
bg-[#EFEDE6]" />
      </div>
    </div>
  );
}'''

OLD_LOADING = '''      {isLoading ? (
        <p className="text-[13px] text-[#8A8578]">Loading property…</p>
      ) : isError || !property || !id ? ('''

NEW_LOADING = '''      {isLoading ? (
        <PropertyDetailSkeleton />
      ) : isError || !property || !id ? ('''

if OLD_IMPORT_ANCHOR not in text:
    raise SystemExit("Import anchor not found — file may have changed. 
Aborting.")
if OLD_LOADING not in text:
    raise SystemExit("Loading block not found — file may have changed. 
Aborting.")

text = text.replace(OLD_IMPORT_ANCHOR, OLD_IMPORT_ANCHOR + SKELETON_FN, 1)
text = text.replace(OLD_LOADING, NEW_LOADING, 1)

backup = path.with_suffix(path.suffix + ".bak")
backup.write_text(path.read_text())
path.write_text(text)

print(f"Patched: {path}")
print(f"Backup saved: {backup}")
