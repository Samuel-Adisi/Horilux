import { Link } from "react-router-dom";
import { useProperties } from "../hooks/use-properties";
import { useSubmitForVerification, usePublishProperty } from "../hooks/use-property-actions";
import type { Property } from "../types";

function formatPrice(price: string, currency: string) {
  const amount = Number(price);
  if (Number.isNaN(amount)) return `${currency} ${price}`;
  return `${currency} ${amount.toLocaleString()}`;
}

function statusLabel(status: string) {
  return status
    .split("_")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

const STATUS_STYLES: Record<string, string> = {
  draft: "bg-gray-100 text-gray-600",
  onboarding: "bg-gray-100 text-gray-600",
  pending_verification: "bg-amber-100 text-amber-700",
  verified: "bg-blue-100 text-blue-700",
  pending_approval: "bg-amber-100 text-amber-700",
  marketing_ready: "bg-blue-100 text-blue-700",
  published: "bg-green-100 text-green-700",
  under_offer: "bg-purple-100 text-purple-700",
  sold_rented: "bg-green-100 text-green-700",
  archived: "bg-gray-100 text-gray-500",
};

function PropertyActions({ property }: { property: Property }) {
  const submitForVerification = useSubmitForVerification();
  const publish = usePublishProperty();

  const canSubmit = property.status === "draft" || property.status === "onboarding";
  const canApprove = property.status === "pending_verification";
  const canPublish = property.status === "marketing_ready";

  const pending = submitForVerification.isPending || publish.isPending;

  return (
    <div className="flex items-center gap-2">
      {canSubmit && (
        <button
          onClick={() => submitForVerification.mutate(property.id)}
          disabled={pending}
          className="rounded-md border border-gray-300 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50"
        >
          {submitForVerification.isPending ? "Submitting…" : "Submit for verification"}
        </button>
      )}
      {canApprove && (
        <span
          title="Requires a completed verification checklist — not yet available in this UI"
          className="cursor-not-allowed rounded-md border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-400"
        >
          Approve
        </span>
      )}
      {canPublish && (
        <button
          onClick={() => publish.mutate(property.id)}
          disabled={pending}
          className="rounded-md bg-[#240270] px-2.5 py-1 text-xs font-medium text-white hover:opacity-90 disabled:opacity-50"
        >
          {publish.isPending ? "Publishing…" : "Publish"}
        </button>
      )}
      {!canSubmit && !canApprove && !canPublish && (
        <span className="text-xs text-gray-400">—</span>
      )}
    </div>
  );
}

function PropertyRow({ property }: { property: Property }) {
  return (
    <tr className="border-b border-gray-100 last:border-0">
      <td className="py-3 pr-4">
        <p className="font-medium text-gray-900">{property.title}</p>
        <p className="text-sm text-gray-500">{property.location}</p>
      </td>
      <td className="py-3 pr-4 text-sm text-gray-600 capitalize">
        {property.property_type} · {property.listing_type}
      </td>
      <td className="py-3 pr-4 text-sm text-gray-600">
        {property.bedrooms ?? "—"} bd · {property.bathrooms ?? "—"} ba
      </td>
      <td className="py-3 pr-4 font-medium text-gray-900">
        {formatPrice(property.price, property.currency)}
      </td>
      <td className="py-3 pr-4">
        <span
          className={`inline-block rounded-full px-2.5 py-1 text-xs font-medium ${
            STATUS_STYLES[property.status] ?? "bg-gray-100 text-gray-600"
          }`}
        >
          {statusLabel(property.status)}
        </span>
      </td>
      <td className="py-3 pr-4 text-sm text-gray-500">{property.completion_percent}%</td>
      <td className="py-3">
        <PropertyActions property={property} />
      </td>
    </tr>
  );
}

export function PropertiesListPage() {
  const { data, isLoading, isError } = useProperties();

  if (isLoading) {
    return <p className="text-sm text-gray-500">Loading properties…</p>;
  }

  if (isError) {
    return <p className="text-sm text-red-600">Failed to load properties.</p>;
  }

  const properties = data?.results ?? [];

  return (
    <div>
      <div className="mb-6 flex items-center justify-between">
        <div>
          <h1 className="text-xl font-semibold text-gray-900">Properties</h1>
          <span className="text-sm text-gray-500">{data?.count ?? 0} total</span>
        </div>
        <Link
          to="/properties/new"
          className="rounded-md bg-[#240270] px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          New Property
        </Link>
      </div>

      {properties.length === 0 ? (
        <p className="text-sm text-gray-500">No properties yet.</p>
      ) : (
        <div className="overflow-x-auto rounded-lg border border-gray-200 bg-white">
          <table className="w-full text-left">
            <thead>
              <tr className="border-b border-gray-200 text-xs uppercase text-gray-500">
                <th className="py-2 pl-4 pr-4 font-medium">Property</th>
                <th className="py-2 pr-4 font-medium">Type</th>
                <th className="py-2 pr-4 font-medium">Beds / Baths</th>
                <th className="py-2 pr-4 font-medium">Price</th>
                <th className="py-2 pr-4 font-medium">Status</th>
                <th className="py-2 pr-4 font-medium">Progress</th>
                <th className="py-2 pr-4 font-medium">Actions</th>
              </tr>
            </thead>
            <tbody className="px-4">
              {properties.map((property) => (
                <PropertyRow key={property.id} property={property} />
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
